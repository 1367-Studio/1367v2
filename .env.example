# --- Sanity ---
# Found in your Sanity project settings (https://www.sanity.io/manage)
PUBLIC_SANITY_PROJECT_ID=""
PUBLIC_SANITY_DATASET="production"
# API version in YYYY-MM-DD format
PUBLIC_SANITY_API_VERSION="2024-01-01"
# Optional: read token for previewing drafts / private datasets
SANITY_API_READ_TOKEN=""

# --- Resend ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sender + destination for the contact form
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_TO_EMAIL=""
