---
import AboutHero from "@/components/AboutHero.astro"
import AboutTextReveal from "@/components/AboutTextReveal.astro";
import AboutOurPhilosophy from "@/components/AboutOurPhilosophy.astro";
import Layout from "@/layouts/Layout.astro";
import LetsBuild from "@/components/LetsBuild.astro";
import { client } from "@/lib/sanity"

const [aboutHero, aboutText, philosophy, letsBuild] = await Promise.all([
  client.fetch(`*[_type == "aboutHeroSection" && _id == "aboutHeroSection"][0]{ leftText, rightText }`),
  client.fetch(`*[_type == "aboutTextRevealSection" && _id == "aboutTextRevealSection"][0]{ text }`),
  client.fetch(`*[_type == "aboutPhilosophySection" && _id == "aboutPhilosophySection"][0]{ label, text, stats }`),
  client.fetch(`*[_type == "letsBuildSection" && _id == "letsBuildSection"][0]{ title, description, ctaLabel, ctaHref }`),
])
---
<Layout
  title="About 1367 Studio | Next.js & Sanity Agency in France"
  description="1367 Studio is an official Sanity agency partner based in Marseille and Paris, building Next.js websites, SaaS platforms and internal tools for teams in France, the UK and the US."
  headerTheme="dark"
>
  <AboutHero
    leftText={aboutHero?.leftText ?? ''}
    rightText={aboutHero?.rightText ?? ''}
  />
  <AboutTextReveal text={aboutText?.text ?? ''}/>
  <AboutOurPhilosophy
    label={philosophy?.label ?? ''}
    text={philosophy?.text ?? ''}
    stats={philosophy?.stats ?? []}/>
  <LetsBuild
    title={letsBuild.title}
    description={letsBuild.description}
    ctaLabel={letsBuild.ctaLabel}
    ctaHref={letsBuild.ctaHref ?? "/contact"}
  />
</Layout>
