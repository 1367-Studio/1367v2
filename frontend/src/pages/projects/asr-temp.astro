---
import Layout from "@/layouts/Layout.astro";
import AsrTempVideoSection from "@/components/AsrTempVideoSection.astro";
import { client } from "@/lib/sanity";

const page = await client.fetch(
  `*[_type == "asrTempProjectSection" && _id == "asrTempProjectSection"][0]{
    sections[]{
      layout,
      videos[]{
        "src": video.asset->url,
        "poster": poster.asset->url
      },
      "svgSrc": svg.asset->url
    }
  }`,
);

const sections = page?.sections ?? [];
---

<Layout
  title="ASR Temp — 1367 Studio"
  description="Case study: ASR Temp, by 1367 Studio."
  headerTheme="dark"
>
  <div class="bg-white flex flex-col gap-4 px-6 lg:px-8 pb-4 pt-[60px] lg:pt-[152px]">
    {sections.map((section: any) => (
      <AsrTempVideoSection layout={section.layout} videos={section.videos ?? []} svgSrc={section.svgSrc} />
    ))}
  </div>
</Layout>
