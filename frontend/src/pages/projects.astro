---
import { client } from "@/lib/sanity";
import FeaturedCase3 from "@/components/FeaturedCase3.astro";
import Layout from "@/layouts/Layout.astro";
import ProjectsGrid from "@/components/ProjectsGrid.astro";
import ProjectsOverview from "@/components/ProjectsOverview.astro";
import ProjectsTabletPicture from "@/components/ProjectsTabletPicture.astro";
import ProjectsTestimonial from "@/components/ProjectsTestimonial.astro";
import ProjectsWhatWeDo from "@/components/ProjectsWhatWeDo.astro";
import LetsBuild from "@/components/LetsBuild.astro";

const [page, featuredCase3] = await Promise.all([
  client.fetch(`
    *[_type == "projectsPageSection" && _id == "projectsPageSection"][0]{
      title,
      description,
      "featuredProjects": featuredProjects[]->{
        title,
        excerpt,
        ctaLabel,
        "slug": slug.current,
        "coverImageUrl": coverImage.asset->url,
        "coverImageAlt": coverImage.alt,
        "coverVideoUrl": coverVideo.asset->url
      },
    }
  `),
  client.fetch(`
    *[_type == "featuredCase3Section" && _id == "featuredCase3Section"][0]{
      cases[]{ tag, title, rightText, ctaLabel, ctaHref,
        "bgImage": bgImage.asset->url,
        "manImageDesktop": manImageDesktop.asset->url,
        "manImageMobile": manImageMobile.asset->url
      }
    }
  `),
]);
---

<Layout
  title="Projects — 1367 Studio"
  description="Case studies from 1367 Studio — branding, websites and software for ambitious teams."
  headerTheme="dark"
>
  <ProjectsGrid
    heading={page?.title}
    subtitle={page?.description}
    projects={(page?.featuredProjects ?? []).filter(Boolean)}
  />
  <LetsBuild
    title="Let's build something great together."
    description="We work with ambitious teams to create brands, websites, and software that help organizations move forward."
  />
</Layout>
