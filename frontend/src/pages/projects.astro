---
import { client } from "@/lib/sanity";
import FeaturedCase3 from "@/components/FeaturedCase3.astro";
import Layout from "@/layouts/Layout.astro";
import ProjectsHero from "@/components/ProjectsHero.astro";
import ProjectsOverview from "@/components/ProjectsOverview.astro";
import ProjectsTabletPicture from "@/components/ProjectsTabletPicture.astro";
import ProjectsTestimonial from "@/components/ProjectsTestimonial.astro";
import ProjectsWhatWeDo from "@/components/ProjectsWhatWeDo.astro";

const [page, featuredCase3] = await Promise.all([
  client.fetch(`
    *[_type == "projectsPageSection" && _id == "projectsPageSection"][0]{
      heroClient, heroTitle, heroService, heroYear, heroIndustry,
      overviewTitle, overviewBody,
      whatWeDidTitle, whatWeDidBody,
      testimonialQuote, testimonialAuthor,
      "tabletImageSrc": tabletImage.asset->url,
      "tabletImageAlt": tabletImage.alt
    }
  `),
  client.fetch(`
    *[_type == "featuredCase3Section" && _id == "featuredCase3Section"][0]{
      cases[]{ tag, title, rightText, ctaLabel, ctaHref,
        "bgImage": bgImage.asset->url,
        "manImageDesktop": manImageDesktop.asset->url,
        "manImageMobile": manImageMobile.asset->url
      }
    }
  `),
]);
---

<Layout
  title="Projects — 1367 Studio"
  description="Case studies from 1367 Studio — branding, websites and software for ambitious teams."
  headerTheme="dark"
>
  <ProjectsHero
    client={page?.heroClient}
    title={page?.heroTitle}
    service={page?.heroService}
    year={page?.heroYear}
    industry={page?.heroIndustry}
  />
  <FeaturedCase3 cases={[featuredCase3?.cases?.[0]].filter(Boolean)} />
  <ProjectsOverview
    title={page?.overviewTitle}
    body={page?.overviewBody}
  />
  <ProjectsTabletPicture
    src={page?.tabletImageSrc}
    alt={page?.tabletImageAlt}
  />
  <ProjectsWhatWeDo
    title={page?.whatWeDidTitle}
    body={page?.whatWeDidBody}
  />
  <ProjectsTestimonial
    quote={page?.testimonialQuote}
    author={page?.testimonialAuthor}
  />
</Layout>
