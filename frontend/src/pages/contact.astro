---
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/components/ContactForm.astro";
---
<Layout
  title="Contact — 1367 Studio | Florianópolis · Marseille · London"
  description="Get in touch with 1367 Studio about branding, custom websites and software. We work with ambitious teams across Brazil, France and the UK."
>
  <section class="mx-auto flex min-h-[80dvh] max-w-3xl flex-col justify-center gap-10 px-6 py-32 lg:px-0">
    <header class="flex flex-col gap-4">
      <span class="font-[Geist_Mono] text-[12px] font-semibold uppercase tracking-widest text-primary">
        Get in touch
      </span>
      <h1 class="font-[Geist] text-4xl font-normal leading-[1.04] tracking-[-0.01em] text-white lg:text-6xl">
        Let's build what's next.
      </h1>
      <p class="max-w-xl font-[Geist] text-base leading-relaxed text-white/70">
        Tell us about your project — branding, a custom website, or software.
        We'll get back to you shortly.
      </p>
    </header>

    <div class="rounded-2xl bg-white p-6 text-ink lg:p-10">
      <ContactForm />
    </div>
  </section>
</Layout>
