---
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/components/ContactForm.astro";
---
<Layout
  title="Contact 1367 Studio | Florianópolis, Marseille & London"
  description="Get in touch with 1367 Studio about branding, custom websites and software. We work with ambitious teams across Brazil, France and the UK."
>
  <section class="min-h-screen bg-primary text-ink">
    <div class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center gap-12 px-6 py-32 lg:px-0">
      <header class="flex flex-col gap-4">
        <span class="font-[Geist_Mono] text-[12px] font-semibold uppercase tracking-widest text-ink/70">
          Get in touch
        </span>
        <h1 class="font-[Geist] text-4xl font-normal leading-[1.04] tracking-[-0.01em] text-ink lg:text-6xl">
          Let's build what's next.
        </h1>
        <p class="max-w-xl font-[Geist] text-base leading-relaxed text-ink/70">
          Tell us about your project, whether it's branding, a custom website,
          or software. We'll get back to you shortly.
        </p>
      </header>

      <ContactForm />
    </div>
  </section>
</Layout>
