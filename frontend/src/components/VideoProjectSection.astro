---
interface Brand {
  name: string
  logoUrl: string
  alt: string
}

interface Props {
  videoUrl?: string
  title?: string
  subtitle?: string
  brandsLabel?: string
  brands?: Brand[]
  marqueeItems?: { label: string }[]
}

const { videoUrl = '/cinematic-reflection.mp4', title = '', subtitle = '', brandsLabel = '', brands = [], marqueeItems = [] } = Astro.props
const doubled = [...marqueeItems, ...marqueeItems]
---

<section id="video-project" style="height: 500vh;">
  <div id="video-project-inner" class="sticky top-0 h-screen w-full overflow-hidden bg-black">

    <!-- Video layer — wrapped in frame div -->
    <div id="video-frame" class="absolute inset-0">
      <video
        id="scrub-video"
        src={videoUrl}
        muted
        playsinline
        autoplay
        preload="auto"
        class="h-full w-full object-cover"
      />
    </div>

    <!-- Orange overlay -->
    <div
      id="orange-overlay"
      class="absolute inset-0 bg-primary"
    />

    <!-- Project content -->
    <div
      id="project-content"
      class="absolute inset-0 flex flex-col items-center justify-center"
    >
      <div class="mx-auto max-w-2xl px-8 text-center text-white">
        {title && (
          <h2 class="font-[Geist] text-[40px] font-normal leading-tight">
            {title}
          </h2>
        )}
        {subtitle && (
          <p class="mx-auto mt-6 max-w-md font-[Geist] text-sm leading-relaxed opacity-80">
            {subtitle}
          </p>
        )}
        {brandsLabel && (
          <p class="mt-16 font-[Geist_Mono] text-xs uppercase tracking-widest opacity-60">
            {brandsLabel}
          </p>
        )}
        {brands.length > 0 && (
          <div class="mt-6 flex items-center justify-center gap-10">
            {brands.map((brand) => (
              <img
                src={brand.logoUrl}
                alt={brand.alt ?? brand.name}
                class="h-6 w-auto opacity-90"
              />
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Marquee -->
    {doubled.length > 0 && (
      <div id="project-marquee" class="absolute bottom-0 left-0 right-0 overflow-hidden whitespace-nowrap py-4">
        <div class="marquee-track inline-flex gap-12">
          {doubled.map((item) => (
            <span class="font-[Geist] text-[40px] tracking-widest text-white">{item.label}</span>
          ))}
        </div>
      </div>
    )}

  </div>
</section>

<style>
  .marquee-track {
    animation: marquee 20s linear infinite;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>

<script>
  import { gsap } from 'gsap'

  const wrapper = document.getElementById('video-project') as HTMLElement
  const video   = document.getElementById('scrub-video')   as HTMLVideoElement
  const frame   = document.getElementById('video-frame')   as HTMLElement
  const overlay = document.getElementById('orange-overlay') as HTMLElement
  const content = document.getElementById('project-content') as HTMLElement
  const marquee = document.getElementById('project-marquee') as HTMLElement | null

  if (wrapper && frame && video && overlay && content) {
    overlay.style.opacity = '0'
    content.style.opacity = '0'
    content.style.transform = 'translateY(60px)'
    if (marquee) {
      marquee.style.opacity = '0'
      marquee.style.transform = 'translateY(20px)'
    }

    const MAX_INSET = 80 // px de moldura no início

    const getProgress = () => {
      const rect = wrapper.getBoundingClientRect()
      const scrollable = wrapper.offsetHeight - window.innerHeight
      return scrollable > 0 ? Math.min(1, Math.max(0, -rect.top / scrollable)) : 0
    }

    let videoReady = false

    const onVideoReady = () => {
      // iOS requires a play/pause cycle before currentTime seeks work on a
      // non-autoplay video. This unlocks the media element without visible playback.
      video.play().then(() => { video.pause(); video.currentTime = 0; videoReady = true })
           .catch(() => { video.currentTime = 0; videoReady = true })
    }

    if (video.readyState >= 1) {
      onVideoReady()
    } else {
      video.addEventListener('loadedmetadata', onVideoReady, { once: true })
    }

    gsap.ticker.add(() => {
      const p = getProgress()

      if (videoReady && video.duration) {
        const videoProgress = Math.max(0, (p - 0.4) / 0.6)
        video.currentTime = videoProgress * video.duration
      }

      // ── Moldura preta (0% → 40% do scroll): 100px → 0px ────────
      const frameProgress = Math.min(1, p / 0.4)
      const inset = MAX_INSET * (1 - frameProgress)
      frame.style.clipPath = `inset(${inset}px)`

      overlay.style.opacity = String(Math.max(0, Math.min(1, (p - 0.4) / 0.6)))

      const cp = Math.max(0, Math.min(1, (p - 0.8) / 0.2))
      content.style.opacity   = String(cp)
      content.style.transform = `translateY(${(1 - cp) * 60}px)`

      // if (marquee) {
      //   marquee.style.opacity   = String(cp)
      //   marquee.style.transform = `translateY(${(1 - cp) * 20}px)`
      // }
    })
  }
</script>
