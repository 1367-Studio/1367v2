---
import { getLogoDimensions } from "@/lib/logo-metrics";

interface Brand {
  name: string;
  logoUrl: string;
  alt: string;
}

interface Props {
  videoUrl?: string;
  heroTitle?: string;
  heroSubtitle?: string;
  heroDescription?: string;
  heroCtaLabel?: string;
  heroCtaHref?: string;
  title?: string;
  subtitle?: string;
  brandsLabel?: string;
  brands?: Brand[];
}

const {
  videoUrl = "/hero-video.mp4",
  heroTitle = "",
  heroSubtitle = "",
  heroDescription = "",
  heroCtaLabel = "",
  heroCtaHref = "/contact",
  title = "",
  subtitle = "",
  brandsLabel = "",
  brands = [],
} = Astro.props;

// Same logo-soup normalisation as the testimonials grid, so square marks
// (Darty) and wide wordmarks (Santander) carry the same visual weight.
const LOGO_BASE_SIZE = 34;
const brandsWithDims = brands.map((brand) => ({
  ...brand,
  dims: getLogoDimensions(brand.logoUrl, LOGO_BASE_SIZE),
}));
---

<section id="video-project" style="height: 500vh; background: #fff;">
  <div
    id="video-project-inner"
    class="sticky top-0 h-screen w-full overflow-hidden bg-white"
  >
    <!-- Video layer -->
    <div
      id="video-frame"
      class="absolute inset-0"
      style="transform: scale(0.55); overflow: hidden;"
    >
      <video
        id="scrub-video"
        src={videoUrl}
        muted
        playsinline
        preload="auto"
        class="h-full w-full object-cover"></video>
    </div>

    <!-- Hero text — bottom row. Text uses difference blend; button is isolated. -->
    <div
      id="hero-text"
      class="absolute bottom-6 left-6 right-6 flex flex-col gap-6 lg:bottom-10 lg:left-10 lg:right-10 lg:flex-row lg:items-end lg:justify-between lg:gap-8"
    >
      <h1
        id="hero-headline"
        class="font-[Geist] text-[32px] font-normal leading-[1.04] will-change-[transform,opacity]"
        style="mix-blend-mode: difference;"
      >
        {/* data-reveal-entry is per-span, not on the <h1>: SplitType rebuilds the
            DOM of whatever it splits, so splitting the h1 would flatten the
            two spans and lose the subtitle's opacity. */}
        {
          heroTitle && (
            <span data-reveal-entry class="block whitespace-pre-line text-white">
              {heroTitle}
            </span>
          )
        }
        {
          heroSubtitle && (
            <span data-reveal-entry class="block whitespace-pre-line text-white opacity-40">
              {heroSubtitle}
            </span>
          )
        }
      </h1>

      <div id="hero-aside" class="flex items-end gap-6 will-change-[transform,opacity]">
        {
          heroDescription && (
            <p
              data-reveal-entry
              class="max-w-[216px] font-[Geist_Mono] text-[12px] font-normal uppercase leading-[1.2] tracking-[-0.01em] text-[#4d4d4d]"
            >
              {heroDescription}
            </p>
          )
        }
        {
          heroCtaLabel && (
            <a
              href={heroCtaHref}
              class="inline-flex h-[48px] shrink-0 items-center justify-center rounded-[8px] bg-primary px-[40px] font-[Geist_Mono] text-[12px] font-semibold uppercase leading-[1.12] tracking-[-0.01em] text-white transition-opacity hover:opacity-90"
            >
              {heroCtaLabel}
            </a>
          )
        }
      </div>
    </div>

    <!-- Orange overlay -->
    <div
      id="orange-overlay"
      class="absolute inset-0 bg-primary"
      style="opacity: 0;"
    >
    </div>

    <!-- Project content (appears at end of scroll over orange) -->
    <div
      id="project-content"
      class="absolute inset-0 flex flex-col items-center justify-center"
      style="opacity: 0; transform: translateY(60px);"
    >
      <div class="mx-auto max-w-2xl px-8 text-center text-white">
        {
          title && (
            <h2 data-reveal-content class="font-[Geist] text-[40px] font-normal leading-[1.04] tracking-[-0.01em]">
              {title}
            </h2>
          )
        }
        {
          subtitle && (
            <p data-reveal-content class="mx-auto mt-6 max-w-md font-[Geist] text-sm leading-relaxed opacity-80">
              {subtitle}
            </p>
          )
        }
        {
          brandsLabel && (
            <p class="mt-16 font-[Geist_Mono] text-xs uppercase tracking-widest opacity-60">
              {brandsLabel}
            </p>
          )
        }
        {
          brandsWithDims.length > 0 && (
            <div class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
              {brandsWithDims.map((brand) => (
                <img
                  src={brand.dims?.src ?? brand.logoUrl}
                  alt={brand.alt || brand.name}
                  loading="lazy"
                  class={brand.dims ? "object-contain opacity-90" : "h-6 w-auto max-w-[140px] object-contain opacity-90"}
                  style={brand.dims
                    ? `width: ${brand.dims.width}px; height: ${brand.dims.height}px; transform: translateY(${brand.dims.offsetY}px); filter: brightness(0) invert(1);`
                    : "filter: brightness(0) invert(1);"}
                />
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
