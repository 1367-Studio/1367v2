---
import type { Heading } from "@/lib/toc";

interface Props {
  headings: Heading[];
}

const { headings = [] } = Astro.props;
---

{
  headings.length > 1 && (
    <nav class="hidden lg:sticky lg:top-32 lg:block lg:self-start">
      <span class="inline-block rounded-[6px] bg-primary px-3 py-1 font-[Geist_Mono] text-[12px] font-normal uppercase leading-[120%] tracking-[-0.01em] text-white">
        On this page
      </span>
      <ul class="mt-4 flex flex-col gap-3 border-l border-[#e5e5e5] pl-4">
        {headings.map((h) => (
          <li
            style={
              h.level > 1 ? `padding-left: ${(h.level - 1) * 12}px` : undefined
            }
          >
            <a
              href={`#${h.id}`}
              class="font-[Geist] text-sm text-[#666666] transition-colors hover:text-black"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
