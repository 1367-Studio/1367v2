---
interface FocusItem {
  title: string
  subItems: string[]
  imageUrl?: string
}

interface Props {
  label?: string
  items: FocusItem[]
}

const { label = 'Focus Areas', items = [] } = Astro.props
---

<section class="relative flex min-h-screen flex-col justify-center bg-white px-8 py-[80px]">
  <div class="relative">

    <!-- Label -->
    <span class="mb-12 block font-[Geist_Mono] text-[12px] font-normal uppercase leading-[1.2] tracking-[-0.01em] text-primary">
      {label}
    </span>

    <!-- Rows -->
    <div id="focus-list" class="flex flex-col gap-8">
      {items.map((item, i) => (
        <div
          class="focus-item group flex cursor-pointer items-end justify-between border-b border-[#e9e9e9] py-[6px]"
          data-index={i}
        >
          <!-- Inner wrapper receives the opacity -->
          <div class="focus-content flex w-full items-end justify-between transition-opacity duration-300">
            <!-- Title -->
            <h2 class="font-[Geist] text-[clamp(28px,3.33vw,48px)] font-normal leading-[1.1] tracking-[-0.01em] text-black">
              {item.title}
            </h2>

            <!-- Sub-items (desktop only) -->
            <div class="hidden items-center gap-6 pb-[6px] md:flex">
              {item.subItems.map((sub) => (
                <span class="font-[Geist_Mono] text-[11px] font-normal uppercase leading-[1.2] tracking-[-0.01em] text-[#666]">
                  {sub}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Image card (absolute, desktop only) -->
    <div
      id="focus-image-card"
      class="pointer-events-none absolute hidden overflow-hidden rounded-[12px] md:block"
      style="width:332px; height:332px; left: 50%; transform: translateX(-50%); transition: top 0.35s ease;"
    >
      {items.map((item, i) => (
        item.imageUrl && (
          <img
            src={item.imageUrl}
            alt={item.title}
            class="focus-img absolute inset-0 h-full w-full object-cover transition-opacity duration-400"
            data-index={i}
            style={`opacity: ${i === 0 ? 1 : 0};`}
          />
        )
      ))}
    </div>

  </div>
</section>

<script>
  const list = document.getElementById('focus-list')
  const card = document.getElementById('focus-image-card')
  const items = list?.querySelectorAll<HTMLElement>('.focus-item')
  const imgs = document.querySelectorAll<HTMLElement>('.focus-img')
  const CARD_H = 332

  function setActive(index: number) {
    items?.forEach((el, i) => {
      const active = i === index
      const content = el.querySelector<HTMLElement>('.focus-content')
      if (content) content.style.opacity = active ? '1' : '0.3'
    })
    imgs.forEach((img) => {
      const idx = Number(img.dataset.index)
      img.style.opacity = idx === index ? '1' : '0'
    })

    // Move card to vertical center of the active row
    if (card && list && items?.[index]) {
      const listRect = list.getBoundingClientRect()
      const rowRect = items[index].getBoundingClientRect()
      const rowCenterY = rowRect.top + rowRect.height / 2 - listRect.top
      card.style.top = `${rowCenterY - CARD_H / 2 + 60}px`
    }
  }

  // default: first item active
  setActive(0)

  items?.forEach((el, i) => {
    el.addEventListener('mouseenter', () => setActive(i))
  })

  // restore first on mouse leave section
  list?.addEventListener('mouseleave', () => setActive(0))
</script>
