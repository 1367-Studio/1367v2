---
interface FocusItem {
  title: string
  subItems: string[]
  imageUrl?: string
}

interface Props {
  label?: string
  items: FocusItem[]
}

const { label = 'Focus Areas', items = [] } = Astro.props
---

<section class="relative bg-white px-8 py-[60px] md:flex md:min-h-screen md:flex-col md:justify-center md:py-[80px]">
  <div class="relative">

    <!-- Label -->
    <span class="mb-8 block font-[Geist_Mono] text-[12px] font-normal uppercase leading-[1.2] tracking-[-0.01em] text-primary md:mb-12">
      {label}
    </span>

    <!-- Rows -->
    <div id="focus-list" class="flex flex-col gap-6 md:gap-8">
      {items.map((item, i) => (
        <div
          class="focus-item cursor-pointer border-b border-[#e9e9e9] py-[6px]"
          data-index={i}
        >
          <div class="focus-content transition-opacity duration-300">

            <!-- Mobile: stacked layout -->
            <div class="flex flex-col gap-2 md:hidden">
              <h2 class="font-[Geist] text-[28px] font-normal leading-[1.1] tracking-[-0.01em] text-black">
                {item.title}
              </h2>
              <div class="flex flex-wrap gap-x-4 gap-y-1 pb-1">
                {item.subItems.map((sub) => (
                  <span class="font-[Geist_Mono] text-[10px] font-normal uppercase leading-[1.2] tracking-[-0.01em] text-[#666]">
                    {sub}
                  </span>
                ))}
              </div>
            </div>

            <!-- Desktop: row layout -->
            <div class="hidden w-full items-end md:flex">
              <h2 class="w-[58%] font-[Geist] text-[clamp(28px,3.33vw,48px)] font-normal leading-[1.1] tracking-[-0.01em] text-black xl:w-[75%]">
                {item.title}
              </h2>
              {/* Fixed 3-column grid, not flex: auto-width flex items let each
                  column's x-position drift with the length of the label before
                  it, so columns never line up row to row. Below xl the columns
                  need more than 25% or the longest labels overflow their cell. */}
              <div class="grid w-[42%] grid-cols-3 items-center gap-6 pb-[6px] xl:w-[25%]">
                {item.subItems.map((sub) => (
                  <span class="font-[Geist_Mono] text-[11px] font-normal uppercase leading-[1.2] tracking-[-0.01em] text-[#666]">
                    {sub}
                  </span>
                ))}
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

    <!-- Preloaded images, hidden — keeps them warm so the reveal has no load delay -->
    <div class="focus-medias" aria-hidden="true">
      {items.map((item, i) => (
        item.imageUrl && <img src={item.imageUrl} alt="" data-index={i} />
      ))}
    </div>

    <!-- Media container: images are created inside this on hover and follow the cursor's Y (desktop only) -->
    <div
      id="media-container"
      class="pointer-events-none absolute hidden overflow-hidden rounded-[12px] md:block"
      style="width:332px; height:332px; top: 0; left: 50%;"
    ></div>

  </div>
</section>

<style>
  .focus-medias img {
    width: 1px;
    height: 1px;
    top: 0;
    left: 0;
    position: absolute;
    visibility: hidden;
    pointer-events: none;
  }

  #media-container {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  #media-container.on {
    opacity: 1;
  }
  /* :global — these target <div>/<img> created client-side by the script below,
     which never get Astro's scoped data-astro-cid attribute. */
  :global(#media-container div) {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform: translate(0, -100%);
  }
  :global(#media-container img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate(0, 90%);
  }
</style>
