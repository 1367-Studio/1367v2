---
interface FocusItem {
  title: string
  subItems: string[]
  imageUrl?: string
}

interface Props {
  label?: string
  items: FocusItem[]
}

const { label = 'Focus Areas', items = [] } = Astro.props
---

<section class="relative bg-white px-8 py-[60px] md:flex md:min-h-screen md:flex-col md:justify-center md:py-[80px]">
  <div class="relative">

    <!-- Label -->
    <span class="mb-8 block font-[Geist_Mono] text-[12px] font-normal uppercase leading-[1.2] tracking-[-0.01em] text-primary md:mb-12">
      {label}
    </span>

    <!-- Rows -->
    <div id="focus-list" class="flex flex-col gap-6 md:gap-8">
      {items.map((item, i) => (
        <div
          class="focus-item cursor-pointer border-b border-[#e9e9e9] py-[6px]"
          data-index={i}
        >
          <div class="focus-content transition-opacity duration-300">

            <!-- Mobile: stacked layout -->
            <div class="flex flex-col gap-2 md:hidden">
              <h2 class="font-[Geist] text-[28px] font-normal leading-[1.1] tracking-[-0.01em] text-black">
                {item.title}
              </h2>
              <div class="flex flex-wrap gap-x-4 gap-y-1 pb-1">
                {item.subItems.map((sub) => (
                  <span class="font-[Geist_Mono] text-[10px] font-normal uppercase leading-[1.2] tracking-[-0.01em] text-[#666]">
                    {sub}
                  </span>
                ))}
              </div>
            </div>

            <!-- Desktop: row layout -->
            <div class="hidden w-full items-end md:flex">
              <h2 class="w-[75%] font-[Geist] text-[clamp(28px,3.33vw,48px)] font-normal leading-[1.1] tracking-[-0.01em] text-black">
                {item.title}
              </h2>
              <div class="flex w-[25%] items-center gap-6 pb-[6px]">
                {item.subItems.map((sub) => (
                  <span class="font-[Geist_Mono] text-[11px] font-normal uppercase leading-[1.2] tracking-[-0.01em] text-[#666]">
                    {sub}
                  </span>
                ))}
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

    <!-- Image card (absolute, desktop only) -->
    <div
      id="focus-image-card"
      class="pointer-events-none absolute hidden overflow-hidden rounded-[12px] md:block"
      style="width:332px; height:332px; left: 50%; transform: translateX(-50%); transition: top 0.35s ease;"
    >
      {items.map((item, i) => (
        item.imageUrl && (
          <img
            src={item.imageUrl}
            alt={item.title}
            class="focus-img absolute inset-0 h-full w-full object-cover transition-opacity duration-400"
            data-index={i}
            style={`opacity: ${i === 0 ? 1 : 0};`}
          />
        )
      ))}
    </div>

  </div>
</section>

<script>
  const list = document.getElementById('focus-list')
  const card = document.getElementById('focus-image-card')
  const items = list?.querySelectorAll<HTMLElement>('.focus-item')
  const imgs = document.querySelectorAll<HTMLElement>('.focus-img')
  const CARD_H = 332

  function setActive(index: number) {
    items?.forEach((el, i) => {
      const content = el.querySelector<HTMLElement>('.focus-content')
      if (content) content.style.opacity = i === index ? '1' : '0.3'
    })
    imgs.forEach((img) => {
      img.style.opacity = Number(img.dataset.index) === index ? '1' : '0'
    })

    if (card && list && items?.[index]) {
      const listRect = list.getBoundingClientRect()
      const rowRect = items[index].getBoundingClientRect()
      const rowCenterY = rowRect.top + rowRect.height / 2 - listRect.top
      card.style.top = `${rowCenterY - CARD_H / 2 + 60}px`
    }
  }

  setActive(0)

  items?.forEach((el, i) => {
    el.addEventListener('mouseenter', () => setActive(i))
    el.addEventListener('click', () => setActive(i))
  })

  list?.addEventListener('mouseleave', () => setActive(0))
</script>
