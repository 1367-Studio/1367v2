---
interface Props {
  label: string
  text?: string
  stats?: { value: string; label: string }[]
}

const {
  label,
  text,
  stats
} = Astro.props

---

<section class="relative w-full min-h-screen bg-primary text-white px-6 xl:px-12 xl:h-screen">
  <div class="flex flex-col justify-between gap-20 md:gap-12 md:min-h-[calc(100vh-192px)]">
    <!-- Left -->
    <div class="w-full max-w-[548px] pt-20 lg:pt-[120px]">
      <span class="block mb-8 xl:mb-12 font-[Geist_Mono] text-[12px] uppercase leading-[1.3] tracking-[-0.01em]">
        {label}
      </span>
      <p class="font-[Geist] font-normal text-[20px] xl:text-[28px] leading-[1.3] tracking-[-0.01em]">
        {text}
      </p>
    </div>

    <!-- Right -->
    <div class="w-full md:max-w-[680px] md:self-end xl:-translate-y-[180px] pb-20">
      {stats?.map(({value, label}) => (
        <div class="flex justify-between border-t border-white/40 py-6 xl:pb-8 xl:pt-0">
          <span class="font-[Geist] text-[42px] md:text-[56px] xl:text-[80px] font-normal leading-[1.3] tracking-[-0.01em]">{value}</span>
          <span class="font-[Geist] text-sm xl:text-base font-normal leading-[1.3] pt-4 xl:pt-[20px]">{label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
