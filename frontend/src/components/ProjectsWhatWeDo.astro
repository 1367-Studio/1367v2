---
interface Props {
  title?: string;
  body?: string;
}

const {
  title = "Turning uncertainty into exhilaration for everyday golfers.",
  body = "",
} = Astro.props;
---

<section
  class="flex flex-col items-center bg-white text-black px-6 md:px-8 lg:px-0"
>
  <div class="w-full max-w-[538px]">
    <h2
      class="font-geist font-normal text-[24px] md:text-[28px] lg:text-[32px] leading-[1.2] tracking-[-0.01em] text-center"
    >
      What we did
    </h2>
    <p
      class="pt-5 pb-6 md:pt-6 md:pb-7 lg:pt-7 lg:pb-8 font-geist font-normal text-[32px] md:text-[40px] lg:text-[48px] leading-[1.2] tracking-[-0.01em] text-center"
    >
      {title}
    </p>
    <p
      class="font-geist font-normal text-sm md:text-base leading-[1.3] tracking-[-0.01em] text-center"
    >
      {body}
    </p>
  </div>
</section>
