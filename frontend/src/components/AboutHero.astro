---
import GravityText from './GravityText.astro'

interface Props {
  leftText: string
  rightText?: string
}

const {
  leftText,
  rightText,
} = Astro.props
---



<section class="relative w-full overflow-hidden h-screen bg-black text-white">
      <div class="relative z-10 flex flex-col gap-8 pt-[40px] px-6 py-12 md:px-8 lg:block">
        <!-- Left text -->
        <p class="relative lg:absolute lg:left-8 lg:top-[80px] max-w-[440px] font-geist font-normal text-base md:text-lg lg:text-2xl leading-snug lg:leading-[1.04] tracking-tight lg:tracking-[-0.01em]">
        {leftText}
        </p>

        <!-- Right text -->
        <p class="relative self-end lg:absolute lg:right-8 lg:top-[200px] max-w-[220px] font-[Geist_Mono] font-normal text-xs leading-[1.2] tracking-[-0.01em] uppercase">
          {rightText}
        </p>
    </div>

    <!-- Gravity text: letters pull toward the cursor, easing back when it leaves.
         Sized so the word (kept tight, letters touching like before) reaches
         close to the same left/right margin as the text above it. -->
    <GravityText
      fontSize="clamp(140px, 42vw, 820px)"
      class="items-end justify-center px-6 pb-0 md:px-8"
      innerClass="translate-y-0 md:translate-y-10 lg:translate-y-20"
    />
</section>
