---
interface Props {
  body: string
}

const { body } = Astro.props
---

<section
  id="statement"
  class="relative flex h-screen w-full items-center justify-center overflow-hidden bg-black"
>
  <p
    id="statement-text"
    class="relative z-10 mx-auto w-[90vw] max-w-[599px] text-center font-geist text-[clamp(22px,5vw,40px)] font-normal leading-[1.3] text-white"
  >
    {body}
  </p>

  <div
    id="statement-iframe"
    class="pointer-events-none absolute left-1/2 top-1/2 z-20 -translate-x-1/2 -translate-y-1/2 -mt-[10px]"
    style="position: absolute;"
  >
    <!-- overlay para fade — iframe fica sempre opacity:1 para o browser não throttle -->
    <div id="statement-iframe-overlay" style="position:absolute;inset:0;background:black;z-index:1;pointer-events:none;"></div>
    <iframe
      allowtransparency="true"
      src="https://app.endlesstools.io/embed/26068064-76e3-48c4-a6be-a7dddf5e5242"
      title=""
      frameborder="0"
      allow="clipboard-write; encrypted-media; gyroscope; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      style="background-color: transparent; width: min(280px, 90vw); height: min(280px, 90vw);"
    />
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const section = document.getElementById('statement')
  const text    = document.getElementById('statement-text')
  const iframe  = document.getElementById('statement-iframe')

  const overlay = document.getElementById('statement-iframe-overlay')

  if (section && text && iframe && overlay) {
    gsap.set(text, { yPercent: 120, autoAlpha: 0 })
    // iframe wrapper só translada — nunca muda opacity para não throttle o browser
    gsap.set(iframe, { yPercent: 120 })
    // overlay começa totalmente opaco (esconde o iframe sem mudar sua opacity)
    gsap.set(overlay, { opacity: 1 })

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: '+=180%',
        pin: true,
        scrub: 1.2,
        anticipatePin: 1,
      },
    })

    // Phase 1 — text enters from below
    tl.to(text, { yPercent: 0, autoAlpha: 1, duration: 1, ease: 'power3.out' })
    // Hold
    tl.to({}, { duration: 0.5 })
    // Phase 2 — iframe entra por baixo E overlay desaparece (iframe sempre opacity:1)
    tl.to(iframe,  { yPercent: -40, duration: 1, ease: 'power3.out' }, '<')
    tl.to(overlay, { opacity: 0,    duration: 1, ease: 'power3.out' }, '<')
    // Hold
    tl.to({}, { duration: 0.3 })
  }
</script>
