---
import USDZViewer from './USDZViewer.tsx'

interface Props {
  body: string
}

const { body } = Astro.props
---

<section
  id="statement"
  class="relative flex h-screen w-full items-center justify-center overflow-hidden bg-black"
>
  <p
    id="statement-text"
    class="relative z-10 mx-auto w-[90vw] max-w-[599px] text-center font-geist text-[clamp(22px,5vw,40px)] font-normal leading-[1.3]"
  >
    {body}
  </p>

  <div
    id="statement-iframe"
    class="pointer-events-none absolute left-1/2 top-1/2 z-20 -translate-x-1/2 -translate-y-1/2 -mt-[10px]"
    style="position: absolute; width: min(280px, 90vw); height: min(280px, 90vw);"
  >
    <USDZViewer
      src="/Endless_Tools_2026-06-09_14-23-55.usdz"
      rotationSpeed={0.015}
      tiltX={0} tiltY={0} tiltZ={0}
      offsetY={0}
      cameraAzimuth={0} cameraElevation={1.57} cameraDistance={1}
      fov={40} scale={1}
      lAmbient={28.5} lTopRight={29.5} lBottomLeft={32} lTopLeft={29.5}
      lFront={30.5} lRight={30.5} lBottom={32.5}
      client:only="react"
    />
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const section = document.getElementById('statement')
  const text    = document.getElementById('statement-text')
  const iframe  = document.getElementById('statement-iframe')

  if (section && text && iframe) {
    // Split the paragraph into words (so it still wraps) and each word into chars
    const words = (text.textContent ?? '').trim().split(/\s+/)
    text.innerHTML = words
      .map(
        (word) =>
          `<span class="word" style="display:inline-block">${[...word]
            .map((ch) => `<span class="char">${ch}</span>`)
            .join('')}</span>`
      )
      .join(' ')

    const chars = text.querySelectorAll('.char')

    // Start grey + iframe below the fold
    gsap.set(chars, { color: 'rgba(255,255,255,0.18)' })
    gsap.set(iframe, { yPercent: 200 })

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: '+=180%',
        pin: true,
        scrub: 1.2,
        anticipatePin: 1,
      },
    })

    // Phase 1 — each letter turns from grey to white as you scroll
    tl.to(chars, {
      color: 'rgba(255,255,255,1)',
      ease: 'none',
      stagger: { each: 0.04 },
    })
    // Phase 2 — iframe rises from below, clipped by the section's overflow-hidden
    tl.to(iframe, { yPercent: -40, duration: 2, ease: 'power3.out' }, '>-0.5')
  }
</script>
