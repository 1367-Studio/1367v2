---
interface ProjectCard {
  title: string;
  slug: string;
  excerpt?: string;
  ctaLabel?: string;
  coverImageUrl?: string;
  coverImageAlt?: string;
  coverVideoUrl?: string;
}

interface Props {
  heading?: string;
  subtitle?: string;
  projects: ProjectCard[];
}

const {
  heading = "Projects That\nMake an Impact",
  subtitle = "From concept to launch, we build products, platforms, and experiences that help organizations move forward.",
  projects = [],
} = Astro.props;

// Placeholder fill for projects without a cover image yet, cycled by
// position so the grid reads as a set rather than one flat gray block.
const PLACEHOLDER_COLORS = ["#000000", "#4D4D4D", "#666666", "#B4B4B4"];
---

<section class="bg-white px-6 pb-16 pt-[100px] text-black lg:px-12 lg:pb-24 lg:pt-[176px]">
  <div class="mx-auto max-w-[1216px]">
    {/* Header */}
    <div class="mb-12 flex flex-col gap-6 lg:mb-16 lg:gap-10">
      <h1
        class="whitespace-pre-line font-[Geist] font-normal text-[32px] leading-[104%] tracking-[-0.01em] md:text-[44px] lg:max-w-[420px] lg:text-[56px]"
      >
        {heading}
      </h1>
      {
        subtitle && (
          <p class="font-[Geist] font-normal text-[16px] leading-[130%] tracking-[-0.01em] text-[#666666] lg:max-w-[280px] lg:self-end">
            {subtitle}
          </p>
        )
      }
    </div>

    {/* Cards */}
    {
      projects.length > 0 ? (
        <div class="grid grid-cols-1 gap-x-4 gap-y-12 md:grid-cols-2 lg:gap-y-16">
          {projects.map((project, i) => (
            <a href={`/projects/${project.slug}`} class="group block">
              <div
                class="aspect-square w-full overflow-hidden rounded-[8px]"
                style={`background-color: ${PLACEHOLDER_COLORS[i % PLACEHOLDER_COLORS.length]};`}
              >
                {project.coverVideoUrl ? (
                  <video
                    src={project.coverVideoUrl}
                    poster={project.coverImageUrl}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  />
                ) : (
                  project.coverImageUrl && (
                    <img
                      src={project.coverImageUrl}
                      alt={project.coverImageAlt || project.title}
                      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                    />
                  )
                )}
              </div>
              <h2 class="mt-6 font-[Geist] text-base font-medium leading-[1.2] tracking-[-0.01em] text-black">
                {project.title}
              </h2>
              {project.excerpt && (
                <p class="mt-2 font-[Geist] text-sm leading-relaxed text-[#666666]">
                  {project.excerpt}
                </p>
              )}
              <span class="mt-4 inline-flex items-center gap-1 font-[Geist_Mono] text-[12px] font-normal uppercase leading-[120%] tracking-[-0.01em] text-black transition-opacity group-hover:opacity-60">
                {project.ctaLabel || "See more"}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="font-[Geist] text-sm text-[#666666]">
          More projects coming soon.
        </p>
      )
    }
  </div>
</section>
