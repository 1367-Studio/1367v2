---
/**
 * Site-wide <head> primitives: title, description, canonical, Open Graph,
 * Twitter cards and Organization/WebSite JSON-LD.
 *
 * Every page must pass a unique `title` and `description`. Sensible
 * site-wide defaults exist as a safety net but should be overridden per page.
 */
export interface Props {
  title?: string;
  description?: string;
  /** OG/Twitter image — relative to the site root or absolute. */
  image?: string;
  /** og:type — "website" for pages, "article" for posts/cases. */
  type?: "website" | "article";
  /** Only for staging/preview routes — never on real pages. */
  noindex?: boolean;
}

const SITE_NAME = "1367 Studio";
const DEFAULT_DESCRIPTION =
  "1367 Studio is an official Sanity agency partner and Next.js development studio building websites, customer portals and SaaS platforms for teams in France, the United Kingdom and the United States.";

// Markets we actively serve. Keep in sync with llms.txt and the agent knowledge.
const AREA_SERVED = [
  { "@type": "Country", name: "France" },
  { "@type": "Country", name: "United Kingdom" },
  { "@type": "Country", name: "United States" },
];
const {
  title = SITE_NAME,
  description = DEFAULT_DESCRIPTION,
  image = "/1367-studio-preview-2026.png",
  type = "website",
  noindex = false,
} = Astro.props;

// Astro.site is set in astro.config.mjs; fall back defensively.
const siteOrigin = Astro.site ?? new URL("https://www.1367studio.com");
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const ogImage = new URL(image, siteOrigin).href;

const SERVICES = [
  "Sanity CMS development & migrations",
  "Next.js website development",
  "SaaS platform development",
  "Customer portals & web applications",
  "Internal tools & integrations",
  "Mobile app development",
  "AI agents for content teams",
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${siteOrigin.origin}/#organization`,
      name: SITE_NAME,
      url: siteOrigin.origin,
      logo: new URL("/favicon.png", siteOrigin).href,
      image: ogImage,
      description: DEFAULT_DESCRIPTION,
      // Real office data (matches the footer / contact page).
      address: {
        "@type": "PostalAddress",
        streetAddress: "Rue Paradis",
        addressLocality: "Marseille",
        postalCode: "13008",
        addressRegion: "Provence-Alpes-Côte d'Azur",
        addressCountry: "FR",
      },
      location: [
        {
          "@type": "Place",
          name: "1367 Studio Marseille",
          address: {
            "@type": "PostalAddress",
            addressLocality: "Marseille",
            postalCode: "13008",
            addressCountry: "FR",
          },
        },
        {
          "@type": "Place",
          name: "1367 Studio Paris",
          address: {
            "@type": "PostalAddress",
            addressLocality: "Paris",
            postalCode: "75008",
            addressCountry: "FR",
          },
        },
      ],
      email: "hello@1367studio.com",
      telephone: "+33 7 63 85 83 88",
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+33 7 63 85 83 88",
        email: "hello@1367studio.com",
        contactType: "sales",
        areaServed: ["FR", "GB", "US"],
        availableLanguage: ["English", "French"],
      },
      areaServed: AREA_SERVED,
      knowsAbout: [
        "Sanity CMS",
        "Headless CMS",
        "Next.js",
        "TypeScript",
        "React",
        "Web development",
        "SaaS development",
        "Content migration",
        "AI agents",
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Services",
        itemListElement: SERVICES.map((name) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name, areaServed: AREA_SERVED },
        })),
      },
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin.origin}/#website`,
      url: siteOrigin.origin,
      name: SITE_NAME,
      description: DEFAULT_DESCRIPTION,
      publisher: { "@id": `${siteOrigin.origin}/#organization` },
      inLanguage: "en",
    },
  ],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

<link rel="icon" type="image/svg+xml" href="/favicon.png" />

{/* Open Graph */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:locale" content="en_US" />
<meta property="og:locale:alternate" content="en_GB" />

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
