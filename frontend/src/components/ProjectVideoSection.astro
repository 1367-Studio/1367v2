---
interface VideoItem {
  src: string
  poster?: string
}

interface Props {
  layout: 'two' | 'one' | 'stack' | 'videoSvg'
  videos: VideoItem[]
  svgSrc?: string
}

const { layout, videos = [], svgSrc } = Astro.props
---

{layout === 'two' && (
  <section class="flex flex-col md:flex-row w-full gap-4">
    {videos.slice(0, 2).map((v) => (
      <div class="w-full md:w-1/2">
        <video
          src={v.src}
          poster={v.poster}
          autoplay
          data-autoplay-in-view
          muted
          loop
          playsinline
          preload="metadata"
          class="w-full h-auto md:h-[869px] md:object-cover rounded-[8px]"
        />
      </div>
    ))}
  </section>
)}

{layout === 'one' && videos[0] && (
  <section class="w-full">
    <video
      src={videos[0].src}
      poster={videos[0].poster}
      autoplay
      data-autoplay-in-view
      muted
      loop
      playsinline
      preload="metadata"
      class="w-full h-auto md:h-[869px] md:object-cover rounded-[8px]"
    />
  </section>
)}

{layout === 'videoSvg' && videos[0] && (
  <section class="flex flex-col md:flex-row w-full gap-4">
    <div class="w-full md:w-1/2">
      <video
        src={videos[0].src}
        poster={videos[0].poster}
        autoplay
        data-autoplay-in-view
        muted
        loop
        playsinline
        preload="metadata"
        class="w-full h-auto md:h-[869px] md:object-cover rounded-[8px]"
      />
    </div>
    {svgSrc && (
      <div class="w-full md:w-1/2 flex items-center justify-center">
        <img src={svgSrc} alt="" class="w-full h-auto rounded-[8px]" />
      </div>
    )}
  </section>
)}

{layout === 'stack' && (
  <section class="flex flex-col md:flex-row w-full gap-4">
    {videos[0] && (
      <div class="w-full md:w-1/2">
        <video
          src={videos[0].src}
          poster={videos[0].poster}
          autoplay
          data-autoplay-in-view
          muted
          loop
          playsinline
          preload="metadata"
          class="w-full h-auto rounded-[8px]"
        />
      </div>
    )}
    <div class="w-full md:w-1/2 flex flex-col gap-4">
      {videos[1] && (
        <div class="w-full">
          <video
            src={videos[1].src}
            poster={videos[1].poster}
            autoplay
            data-autoplay-in-view
            muted
            loop
            playsinline
            preload="metadata"
            class="w-full h-auto rounded-[8px]"
          />
        </div>
      )}
      {videos[2] && (
        <div class="w-full">
          <video
            src={videos[2].src}
            poster={videos[2].poster}
            autoplay
            data-autoplay-in-view
            muted
            loop
            playsinline
            preload="metadata"
            class="w-full h-auto rounded-[8px]"
          />
        </div>
      )}
    </div>
  </section>
)}

<script>
  // Autoplay handles the initial start; this observer just pauses videos
  // once they're off-screen and resumes them on scroll-back, so a page
  // with several 60fps/high-bitrate clips doesn't decode all of them at
  // once (which shows up as dropped-frame stutter). One observer, shared
  // across every ProjectVideoSection instance on the page.
  const win = window as Window & { __lazyVideoObserverInit?: boolean };

  if (!win.__lazyVideoObserverInit) {
    win.__lazyVideoObserverInit = true;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { rootMargin: "200px 0px", threshold: 0.15 },
    );

    document
      .querySelectorAll("video[data-autoplay-in-view]")
      .forEach((video) => observer.observe(video));
  }
</script>
