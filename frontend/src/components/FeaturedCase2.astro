---
interface Props {
  tag?: string
  title: string
  description?: string
  ctaLabel?: string
  ctaHref?: string
  imageSrc?: string
  imageTitle?: string
}

const {
  tag,
  title,
  description,
  ctaHref = '#',
  ctaLabel,
  imageSrc,
  imageTitle,
   } = Astro.props
---

<section class="flex flex-col lg:flex-row lg:h-screen">

 <!-- Left: dark panel -->
  <div class="relative flex w-full lg:w-1/2 flex-col justify-center gap-8 bg-black px-6 py-12 lg:px-12 lg:py-10">
    {tag && (
      <span class="font-[Geist_Mono] text-[12px] uppercase tracking-widest text-white">
        {tag}
      </span>
    )}

    <div class="max-w-full lg:max-w-[400px]">
      <h2 id="featured-title" class="font-[Geist] text-[24px] font-normal leading-[1.1] text-white">
        {title}
      </h2>
      {description && (
        <p class="mt-5 font-['Instrument_Sans'] text-[16px] font-normal leading-[1.3] tracking-normal text-white">
          {description}
        </p>
      )}
    </div>
      <a
      href={ctaHref}
      class="mt-4 font-[Geist_Mono] text-[12px] uppercase tracking-widest text-white"
    >
      {ctaLabel}
    </a>
  </div>

  {/* Right: light panel */}
  <div class="flex flex-col relative w-full h-[60vh] lg:h-auto lg:w-1/2 bg-[#e8e0d4] py-12">
  <h3 class="text-ink text-xl md:text-2xl text-center py-8 whitespace-nowrap">{imageTitle}</h3>
  <div class="self-end w-9/10 h-[80%] overflow-hidden rounded-l-lg">
    <img src={imageSrc} alt="smailing people working" class="h-full w-full object-contain" />
  </div>
</div>

</section>
