---
// Posts to the Resend-backed endpoint at /api/contact
---

<form
  id="contact-form"
  class="flex w-full max-w-lg flex-col gap-9"
  method="POST"
  action="/api/contact"
>
  <input
    type="text"
    name="name"
    placeholder="Name"
    required
    class="w-full appearance-none border-0 border-b border-ink/30 bg-transparent pb-3 font-[Geist] text-lg text-ink placeholder:text-ink/50 outline-none transition-colors focus:border-ink"
  />
  <input
    type="email"
    name="email"
    placeholder="Email"
    required
    class="w-full appearance-none border-0 border-b border-ink/30 bg-transparent pb-3 font-[Geist] text-lg text-ink placeholder:text-ink/50 outline-none transition-colors focus:border-ink"
  />
  <textarea
    name="message"
    placeholder="Message"
    rows="3"
    required
    class="w-full resize-none appearance-none border-0 border-b border-ink/30 bg-transparent pb-3 font-[Geist] text-lg text-ink placeholder:text-ink/50 outline-none transition-colors focus:border-ink"
  ></textarea>
  <button
    type="submit"
    class="mt-2 inline-flex w-fit items-center justify-center rounded-full bg-ink px-8 py-3 font-[Geist_Mono] text-[12px] font-semibold uppercase tracking-widest text-white transition-opacity hover:opacity-80"
  >
    Send
  </button>
  <p id="contact-status" class="text-sm text-ink/70" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;

    status.textContent = "Sending…";
    const data = Object.fromEntries(new FormData(form));

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      status.textContent = res.ok
        ? "Thanks, your message was sent."
        : "Something went wrong. Please try again.";
      if (res.ok) form.reset();
    } catch {
      status.textContent = "Network error. Please try again.";
    }
  });
</script>
