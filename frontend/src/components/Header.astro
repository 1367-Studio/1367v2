---
import { client } from '../lib/sanity'
import { Menu, X } from '@lucide/astro';

const header = await client.fetch(`
  *[_type == "header"][0]{
    "logoUrl": logo.asset->url,
    navigation
  }
`)

const logoUrl = header?.logoUrl

// Fallback destinations for known nav labels when Sanity has no href yet.
// Items that resolve to no destination are dropped so we never emit dead links.
// (Projects / About reappear automatically once they have a real href in Sanity.)
const HREF_FALLBACKS: Record<string, string> = {
  contact: '/contact',
  'contact us': '/contact',
  'get in touch': '/contact',
}

const navItems = (header?.navigation ?? [])
  .map((item: any) => ({
    ...item,
    href: item?.href || HREF_FALLBACKS[item?.label?.toLowerCase()?.trim()],
  }))
  .filter((item: any) => item.href)

const leftLinks = navItems.filter((item: any) => item.position === 'left')
const rightLinks = navItems.filter((item: any) => item.position === 'right')
const allLinks = [...leftLinks, ...rightLinks]
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 flex justify-center px-8 py-5"
>
  <div class="flex w-full max-w-3xl items-center justify-between">
    <nav class="flex gap-6 cursor-pointer hidden md:flex">
      {leftLinks?.map((item: any) => (
        <a href={item.href} class="font-[Geist] text-[14px] font-normal leading-[1.12] tracking-[-0.01em] text-center text-black opacity-100 transition-all duration-200 hover:opacity-60">{item.label}</a>
      ))}
    </nav>

    <a href="/" class="shrink-0">
      {logoUrl
        ? <img src={logoUrl} alt="1367 Studio" class="h-6 w-auto" />
        : <span class="font-bold text-black">1367</span>
      }
    </a>

    <nav class="flex gap-6 cursor-pointer items-center hidden md:flex">
      {rightLinks?.map((item: any) => (
        <a href={item.href} class="font-[Geist] text-[14px] font-normal leading-[1.12] tracking-[-0.01em] text-center text-black opacity-100 transition-all duration-200 hover:opacity-60">{item.label}</a>
      ))}
    </nav>

    <!-- hamburger button -->
    <button id="menu-btn" class="text-black md:hidden relative z-50">
      <Menu id="icon-menu" size={16} />
      <X id="icon-close" size={16} class="hidden" />
    </button>
  </div>

  <!-- popup menu -->
  <div
    id="mobile-menu" class="absolute top-[52px] right-8 mt-2 min-w-[160px] bg-black/80 backdrop-blur-md rounded-xl flex flex-col py-3 opacity-0 scale-95 pointer-events-none transition-all duration-200 origin-top-right md:hidden">
    {allLinks?.map((item: any) => ( <a href={item.href} class="px-5 py-2.5 font-[Geist] text-[14px] text-white opacity-80 hover:opacity-100 transition-opacity">
    {item.label}
  </a>
))}
  </div>
</header>

<style>
  #site-header {
    opacity: 0;
    transform: translateY(-12px);
    transition: transform 0.4s ease, opacity 0.5s ease;
  }

  #site-header.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #mobile-menu.is-open {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
  }
</style>

<script>
  const header = document.getElementById('site-header')!
  const btn = document.getElementById('menu-btn')!
  const menu = document.getElementById('mobile-menu')!
  const iconMenu = document.getElementById('icon-menu')!
  const iconClose = document.getElementById('icon-close')!

  // Entrada: aguarda um frame para a transition capturar a mudança
  requestAnimationFrame(() => {
    setTimeout(() => header.classList.add('is-visible'), 200)
  })

  // popup toggle
  btn.addEventListener('click', () => {
    const isOpen = menu.classList.toggle('is-open')
    iconMenu.classList.toggle('hidden', isOpen)
    iconClose.classList.toggle('hidden', !isOpen)
  })

  // close when clicking elsewhere
  document.addEventListener('click', (e) => {
    if (!header.contains(e.target as Node)) {
      menu.classList.remove('is-open')
      iconMenu.classList.remove('hidden')
      iconClose.classList.add('hidden')
    }
  })
</script>
