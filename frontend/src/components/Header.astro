---
import { client } from '../lib/sanity'
import { Menu, X } from '@lucide/astro';

const header = await client.fetch(`
  *[_type == "header"][0]{
    "logoUrl": logo.asset->url,
    navigation
  }
`)

const logoUrl = header?.logoUrl

// Fallback destinations for known nav labels when Sanity has no href yet.
// Items that resolve to no destination are dropped so we never emit dead links.
// (Projects / About reappear automatically once they have a real href in Sanity.)
const HREF_FALLBACKS: Record<string, string> = {
  contact: '/contact',
  'contact us': '/contact',
  'get in touch': '/contact',
  about: '/about',
  'about us': '/about',
}

const navItems = (header?.navigation ?? [])
  .map((item: any) => ({
    ...item,
    href: item?.href || HREF_FALLBACKS[item?.label?.toLowerCase()?.trim()],
  }))
  .filter((item: any) => item.href)

const leftLinks = navItems.filter((item: any) => item.position === 'left')
const rightLinks = navItems.filter((item: any) => item.position === 'right')
const allLinks = [...leftLinks, ...rightLinks]

interface Props {
  theme?: 'light'| 'dark'
}
const {theme = 'light'} = Astro.props
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 flex justify-center px-8 py-5"
>
  <div class="flex w-full max-w-3xl items-center justify-between">
    <nav class="flex gap-6 cursor-pointer hidden md:flex">
      {leftLinks?.map((item: any) => (
        <a href={item.href} class="header-link font-[Geist] text-[14px] font-normal leading-[1.12] tracking-[-0.01em] text-center opacity-100 transition-all duration-200 hover:opacity-60">{item.label}</a>
      ))}
    </nav>

    <a href="/" class="shrink-0">
      {logoUrl
        ? <img src={logoUrl} alt="1367 Studio" class="header-logo h-6 w-auto" />
        : <span class="header-link font-bold">1367</span>
      }
    </a>

    <nav class="flex gap-6 cursor-pointer items-center hidden md:flex">
      {rightLinks?.map((item: any) => (
        <a href={item.href} class="header-link font-[Geist] text-[14px] font-normal leading-[1.12] tracking-[-0.01em] text-center opacity-100 transition-all duration-200 hover:opacity-60">{item.label}</a>
      ))}
    </nav>

    <!-- hamburger button -->
    <button id="menu-btn" class="header-link md:hidden relative z-50">
      <Menu id="icon-menu" size={16} />
      <X id="icon-close" size={16} class="hidden" />
    </button>
  </div>

  <!-- popup menu -->
  <div
    id="mobile-menu" class="absolute top-[52px] right-8 mt-2 min-w-[160px] bg-black/80 backdrop-blur-md rounded-xl flex flex-col py-3 opacity-0 scale-95 pointer-events-none transition-all duration-200 origin-top-right md:hidden">
    {allLinks?.map((item: any) => ( <a href={item.href} class="px-5 py-2.5 font-[Geist] text-[14px] text-white opacity-80 hover:opacity-100 transition-opacity">
    {item.label}
  </a>
))}
  </div>
</header>

<style>
  #site-header {
    opacity: 0;
    transform: translateY(-12px);
    transition: transform 0.4s ease, opacity 0.5s ease;
    --hc: #000000;
  }

  #site-header.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #site-header[data-theme="light"] {
    --hc: #ffffff;
  }

  .header-link {
    color: var(--hc);
    transition: color 0.3s ease, opacity 0.2s ease;
  }

  .header-logo {
    filter: brightness(0);
    transition: filter 0.3s ease;
  }

  #site-header[data-theme="light"] .header-logo {
    filter: brightness(0) invert(1);
  }

  #mobile-menu.is-open {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }
</style>

<script>
  const header = document.getElementById('site-header')!
  const btn = document.getElementById('menu-btn')!
  const menu = document.getElementById('mobile-menu')!
  const iconMenu = document.getElementById('icon-menu')!
  const iconClose = document.getElementById('icon-close')!

  // Entrada: aguarda um frame para a transition capturar a mudança
  requestAnimationFrame(() => {
    setTimeout(() => header.classList.add('is-visible'), 200)
  })

  // Adaptive color: detecta o bg atrás do header automaticamente
  function isBlack(color: string): boolean {
    const m = color.match(/\d+/g)
    if (!m || m.length < 3) return false
    const [r, g, b] = m.map(Number)
    return r < 30 && g < 30 && b < 30
  }

  function updateHeaderTheme() {
    const cy = header.getBoundingClientRect().bottom + 4
    const cx = window.innerWidth / 2
    const elements = document.elementsFromPoint(cx, cy)

    for (const el of elements) {
      if (header.contains(el) || el === header) continue
      if (el === document.body || el === document.documentElement) continue
      // data-header-theme tem prioridade
      const forced = (el as HTMLElement).dataset?.headerTheme
      if (forced) { header.setAttribute('data-theme', forced); return }
      const bg = getComputedStyle(el).backgroundColor
      if (bg && bg !== 'rgba(0, 0, 0, 0)' && bg !== 'transparent') {
        header.setAttribute('data-theme', isBlack(bg) ? 'light' : 'dark')
        return
      }
    }
    // fallback: usa o bg do body
    const bodyBg = getComputedStyle(document.body).backgroundColor
    header.setAttribute('data-theme', isDark(bodyBg) ? 'light' : 'dark')
  }

  updateHeaderTheme()
  window.addEventListener('scroll', updateHeaderTheme, { passive: true })

  // popup toggle
  btn.addEventListener('click', () => {
    const isOpen = menu.classList.toggle('is-open')
    iconMenu.classList.toggle('hidden', isOpen)
    iconClose.classList.toggle('hidden', !isOpen)
  })

  // close when clicking elsewhere
  document.addEventListener('click', (e) => {
    if (!header.contains(e.target as Node)) {
      menu.classList.remove('is-open')
      iconMenu.classList.remove('hidden')
      iconClose.classList.add('hidden')
    }
  })
</script>
