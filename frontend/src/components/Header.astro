---
import { client } from '../lib/sanity'
import { Menu } from '@lucide/astro';
import imageUrlBuilder from '@sanity/image-url'

const header = await client.fetch(`
  *[_type == "header"][0]{
    "logoUrl": logo.asset->url,
    navigation
  }
`)

const logoUrl = header?.logoUrl
console.log('[Header] logoUrl:', logoUrl)

const leftLinks = header?.navigation?.filter((item: any) => item.position === 'left')
const rightLinks = header?.navigation?.filter((item: any) => item.position === 'right')
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 flex justify-center px-8 py-5"
>
  <div class="flex w-full max-w-3xl items-center justify-between">
    <nav class="flex gap-6">
      {leftLinks?.map((item: any) => (
        <a href={item.href} class="font-[Geist] text-[14px] font-normal leading-[1.12] tracking-[-0.01em] text-center text-white opacity-100 transition-all duration-200 hover:opacity-60">{item.label}</a>
      ))}
    </nav>

    <a href="/" class="shrink-0">
      {logoUrl
        ? <img src={logoUrl} alt="1367 Studio" class="h-6 w-auto" />
        : <span class="font-bold text-white">1367</span>
      }
    </a>

    <nav class="flex gap-6 items-center">
      {rightLinks?.map((item: any) => (
        <a href={item.href} class="font-[Geist] text-[14px] font-normal leading-[1.12] tracking-[-0.01em] text-center text-white opacity-100 transition-all duration-200 hover:opacity-60">{item.label}</a>
      ))}
      <button class="text-white"><Menu size={16} /></button>
    </nav>
  </div>
</header>

<style>
  #site-header {
    opacity: 0;
    transform: translateY(-12px);
    transition: transform 0.4s ease, opacity 0.5s ease, background-color 0.3s ease, backdrop-filter 0.3s ease;
  }

  #site-header.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #site-header.is-hidden {
    transform: translateY(-100%);
  }

  #site-header.scrolled {
    background-color: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
</style>

<script>
  const header = document.getElementById('site-header')!
  let lastY = 0

  // Entrada: aguarda um frame para a transition capturar a mudança
  requestAnimationFrame(() => {
    setTimeout(() => header.classList.add('is-visible'), 200)
  })

  window.addEventListener('scroll', () => {
    const y = window.scrollY

    header.classList.toggle('scrolled', y > 60)

    if (y > lastY && y > 120) {
      header.classList.add('is-hidden')
    } else {
      header.classList.remove('is-hidden')
    }

    lastY = y
  }, { passive: true })
</script>
