---
interface Props {
  src?: string;
  alt?: string;
}

const { src, alt = '' } = Astro.props;
---

{src && (
  <section>
    <div class="px-0 py-0 md:py-[60px] md:px-[24px] lg:py-[120px] lg:px-[32px]">
      <img src={src} alt={alt} class="w-full h-full object-cover" />
    </div>
  </section>
)}
