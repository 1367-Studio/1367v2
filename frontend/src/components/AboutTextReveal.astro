---
interface Props {
  text: string
}

const {text} = Astro.props
---

<section class="relative w-full min-h-screen overflow-hidden bg-white text-black px-6 md:px-8">
  <div class="flex items-center mx-auto min-h-screen max-w-[680px]">
    <p class="font-[Geist] font-normal text-base sm:text-lg md:text-xl lg:text-[32px]
              leading-snug md:leading-relaxed lg:leading-[1.3]
              tracking-tight md:tracking-normal lg:tracking-[-0.01em]
              text-center">
              {text}
    </p>
  </div>
</section>
