---
import { getLogoDimensions } from '@/lib/logo-metrics'

interface Testimonial {
  quote: string
  author: string
  avatarUrl?: string
}

interface Brand {
  name: string
  logoUrl?: string
  alt?: string
}

interface Props {
  testimonials: Testimonial[]
  brandsLabel?: string
  brands: Brand[]
}

const {
  testimonials = [],
  brandsLabel = 'Trusted by brands worldwide:',
  brands = [],
} = Astro.props

const total = testimonials.length

// logo-soup normalization: square logos render near the old fixed 42px,
// wide wordmarks shrink so every logo carries the same visual weight
const LOGO_BASE_SIZE = 48
const brandsWithDims = brands.map((brand) => ({
  ...brand,
  dims: getLogoDimensions(brand.logoUrl, LOGO_BASE_SIZE),
}))
---

<section id="testimonials-section" class="bg-white px-6 py-16 md:flex md:min-h-screen md:flex-col md:justify-center lg:px-12 lg:py-24">
  <div class="flex flex-col gap-20 lg:flex-row lg:gap-96">

    <!-- Left: Testimonial carousel -->
    <div class="lg:w-[38%]">
      <!-- Progress bar no topo -->
      <div class="mb-8 h-[1px] bg-black/10">
        <div id="testimonial-progress" class="h-full bg-black" style="width: 0%;" />
      </div>

      <div id="testimonial-card">
        {testimonials.map((t, i) => (
          <div
            class="testimonial-slide grid grid-cols-[auto_1fr_auto] gap-5 items-start"
            data-index={i}
            style={i !== 0 ? 'display:none' : ''}
          >
            <!-- Coluna 1: Foto -->
            <div class="flex-shrink-0 overflow-hidden" style="width: 73px; height: 98px;">
              {t.avatarUrl ? (
                <img src={t.avatarUrl} alt={t.author} class="h-full w-full object-cover" />
              ) : (
                <div class="h-full w-full bg-black/10" />
              )}
            </div>

            <!-- Coluna 2: Quote + autor -->
            <div class="flex min-w-0 flex-col gap-6 lg:w-[250px]">
              <p class="font-[Geist] text-[16px] font-normal text-black" style="line-height: 104%; letter-spacing: -0.01em;">
                &ldquo;{t.quote}&rdquo;
              </p>
              <p class="font-[Geist] text-[14px] font-normal text-black" style="line-height: 104%; letter-spacing: -0.01em;">
                {t.author}
              </p>
            </div>

            <!-- Coluna 3: Contador -->
            <span class="font-[Geist_Mono] text-[12px] font-normal uppercase whitespace-nowrap" style="line-height: 120%; letter-spacing: -0.01em; color: #000;">
              {String(i + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Right: Brand logos -->
    <div class="lg:w-[62%]">
      <p class="mb-6 font-[Geist] text-[14px] font-normal text-black" style="line-height: 120%; letter-spacing: -0.01em;">
        {brandsLabel}
      </p>
      <div class="p-0">
        <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-14">
          {brandsWithDims.map((brand) => (
            <div class="flex items-center justify-start">
              {brand.logoUrl && brand.dims ? (
                <img
                  src={brand.dims.src}
                  alt={brand.alt || brand.name}
                  class="max-w-full object-contain"
                  style={`width: ${brand.dims.width}px; height: ${brand.dims.height}px; transform: translateY(${brand.dims.offsetY}px);`}
                />
              ) : brand.logoUrl ? (
                <img
                  src={brand.logoUrl}
                  alt={brand.alt || brand.name}
                  class="max-w-full object-contain" style="height: 42px; width: auto; max-height: 42px;"
                />
              ) : (
                <span class="font-[Geist_Mono] text-[12px] text-black/40">{brand.name}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>
