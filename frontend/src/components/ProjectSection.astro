---
import { getLogoDimensions } from '@/lib/logo-metrics'

interface Brand {
  name: string
  logoUrl: string
  alt: string
}

interface Props {
  title: string
  subtitle: string
  brandsLabel: string
  brands: Brand[]
}

const { title, subtitle, brandsLabel, brands = [] } = Astro.props

// logo-soup normalization at the scale of the old fixed h-6 (24px) strip
const LOGO_BASE_SIZE = 28
const brandsWithDims = brands.map((brand) => ({
  ...brand,
  dims: getLogoDimensions(brand.logoUrl, LOGO_BASE_SIZE),
}))
---

<section class="bg-primary px-8 py-40 text-center text-white">
  <div class="mx-auto max-w-2xl">

    {/* Title */}
    <h2 class="text-4xl leading-tight md:text-[40px]">
      {title}
    </h2>

    {/* Subtitle */}
    <p class="mx-auto mt-6 max-w-md text-sm leading-relaxed opacity-80">
      {subtitle}
    </p>

    {/* Label for brands */}
    <p class="mt-16 text-xs opacity-60">
      {brandsLabel}
    </p>

    {/* Logos */}
    <div class="mt-6 flex items-center justify-center gap-10">
      {brandsWithDims.map((brand) => (
        <img
          src={brand.dims?.src ?? brand.logoUrl}
          alt={brand.alt ?? brand.name}
          class={brand.dims ? 'opacity-90' : 'h-6 w-auto opacity-90'}
          style={brand.dims
            ? `width: ${brand.dims.width}px; height: ${brand.dims.height}px; transform: translateY(${brand.dims.offsetY}px);`
            : undefined}
        />
      ))}
    </div>

  </div>
</section>
