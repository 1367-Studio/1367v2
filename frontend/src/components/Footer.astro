---
interface Location {
  city: string;
  country: string;
  phone?: string;
  address?: string;
}

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  lang?: "en" | "fr";
  heading?: string;
  ctaLabel?: string;
  ctaHref?: string;
  navLinks?: NavLink[];
  locations?: Location[];
  logoSrc?: string;
}

const fr = Astro.props.lang === "fr";

const {
  heading = fr ? "Imaginons\nla suite." : "Let's design\nwhat's next.",
  ctaLabel = fr ? "NOUS CONTACTER" : "CONTACT US",
  ctaHref = "/contact",
  navLinks = fr
    ? [
        { label: "Projets", href: "/projects" },
        { label: "À propos", href: "/about" },
        { label: "Politique de confidentialité", href: "/legal/privacy-policy" },
        { label: "Mentions légales", href: "/legal/mentions-legales" },
        { label: "Nous contacter", href: "/contact" },
      ]
    : [
        { label: "Projects", href: "/projects" },
        { label: "About us", href: "/about" },
        { label: "Privacy Policy", href: "/legal/privacy-policy" },
        { label: "Legal Notice", href: "/legal/mentions-legales" },
        { label: "Get in touch", href: "/contact" },
      ],
  locations = [
    { city: "Marseille", country: "France", phone: "+33 07 63 85 83 88" },
    { city: "Paris", country: "France", phone: "+33 07 63 85 83 88" },
    { city: "London", country: "United Kingdom", phone: "+33 07 63 85 83 88" },
  ],
  logoSrc,
} = Astro.props;

// Service pages: internal links so search engines (and people) find them.
const serviceLinks = [
  { label: "Sanity agency", href: "/sanity-agency" },
  { label: "Sanity migration", href: "/sanity-migration" },
  { label: "Next.js agency", href: "/nextjs-agency" },
  { label: "Agence Sanity", href: "/fr/agence-sanity", lang: "fr" },
  { label: "Agence web Marseille", href: "/fr/agence-web-marseille", lang: "fr" },
  { label: "Migration Sanity", href: "/fr/migration-sanity", lang: "fr" },
];
---

<footer id="site-footer" class="relative overflow-hidden bg-primary">
  <!-- Top content -->
  <div
    class="relative z-20 flex flex-col gap-10 px-6 pt-12 pb-0 lg:flex-row lg:items-start lg:px-12 lg:pt-16 lg:gap-0"
  >
    <!-- Left: logo + heading + CTA -->
    <div class="flex flex-col gap-10 lg:w-[58%]">
      <h2
        class="font-[Geist] text-[28px] lg:text-[40px] font-normal leading-[1.04] tracking-[-0.01em] text-white whitespace-pre-line"
      >
        {heading}
      </h2>
      <a
        href={ctaHref}
        class="inline-flex h-[44px] w-fit items-center justify-center rounded-[8px] bg-white px-8 font-[Geist_Mono] text-[12px] font-semibold uppercase leading-[1.12] tracking-[-0.01em] text-primary"
      >
        {ctaLabel}
      </a>
    </div>

    <!-- Right group: nav + locations -->
    <div class="flex flex-col gap-10 lg:flex-1 lg:flex-row lg:justify-between">
      <!-- Center: nav links -->
      <nav class="flex flex-col gap-7 lg:pt-2">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="font-[Geist] text-[16px] font-medium leading-[1.2] tracking-[-0.01em] text-white transition-opacity hover:opacity-60"
            >
              {link.label}
            </a>
          ))
        }
        <button
          type="button"
          data-cookie-settings
          class="cursor-pointer text-left font-[Geist] text-[16px] font-medium leading-[1.2] tracking-[-0.01em] text-white transition-opacity hover:opacity-60"
        >
          {fr ? "Gérer les cookies" : "Cookie settings"}
        </button>
      </nav>

      <!-- Services -->
      <nav aria-label="Services" class="flex flex-col gap-4 lg:pt-2">
        {
          serviceLinks.map((link) => (
            <a
              href={link.href}
              hreflang={link.lang}
              class="font-[Geist] text-[14px] font-normal leading-[1.2] tracking-[-0.01em] text-white/80 transition-opacity hover:opacity-60"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Right: locations -->
      <div class="flex flex-col gap-11 lg:pt-2">
        {
          locations.map((loc) => (
            <div>
              <p class="font-[Geist] text-[16px] font-medium leading-[1.2] tracking-[-0.01em] text-white">
                {loc.city}, {loc.country}
              </p>
              {loc.phone && (
                <p class="mt-2 font-[Geist] text-[14px] font-normal leading-[1.2] tracking-[-0.01em] text-white">
                  {loc.phone}
                </p>
              )}
              {loc.address && (
                <p class="mt-2 font-[Geist] text-[14px] font-normal leading-[1.2] tracking-[-0.01em] text-white whitespace-pre-line">
                  {loc.address}
                </p>
              )}
            </div>
          ))
        }
      </div>
    </div>
    <!-- end right group -->
  </div>

  <!-- "1367" wordmark, full-bleed inside the footer. No side margin — it spans
       the full footer width so it reads as part of the footer, not a boxed-in
       container. The gradient overlay fades its bottom edge into the footer's
       orange instead of cutting it off sharply. -->
  <div class="relative mt-16 lg:mt-[170px]">
    <img src="/logo-1367.svg" alt="1367" class="w-full" />
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2"
      style="background: linear-gradient(to top in srgb, #f43c00 0%, rgba(244, 60, 0, 0) 100%);"
    >
    </div>
  </div>
</footer>
