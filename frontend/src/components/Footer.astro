---
interface Location {
  city: string
  country: string
  phone?: string
  address?: string
}

interface NavLink {
  label: string
  href: string
}

interface Props {
  heading?: string
  ctaLabel?: string
  ctaHref?: string
  navLinks?: NavLink[]
  locations?: Location[]
  logoSrc?: string
}

const {
  heading = "Let's design\nwhat's next.",
  ctaLabel = 'CONTACT US',
  ctaHref = '/contact',
  navLinks = [
    { label: 'About us', href: '/about' },
    { label: 'Get in touch', href: '/contact' },
  ],
  locations = [
    { city: 'Marseille', country: 'France', phone: '+33 07 63 85 83 88' },
    { city: 'London', country: 'UK', phone: '+33 07 63 85 83 88' },
    { city: 'Florianópolis', country: 'Brazil', phone: '48 99195-8826', address: 'SC-405, 4397 - Campeche,\nFlorianópolis - SC, 88065-000\nOKA SHOPPING' },
  ],
  logoSrc,
} = Astro.props
---

<footer id="site-footer" class="relative overflow-hidden bg-primary">
  <!-- Top content -->
  <div class="relative z-20 flex flex-col gap-10 px-6 pt-12 pb-0 lg:flex-row lg:items-start lg:px-12 lg:pt-16 lg:gap-0">
    <!-- Left: logo + heading + CTA -->
    <div class="flex flex-col gap-10 lg:w-[58%]">
      <h2 class="font-[Geist] text-[28px] lg:text-[40px] font-normal leading-[1.04] tracking-[-0.01em] text-white whitespace-pre-line">
        {heading}
      </h2>
      <a
        href={ctaHref}
        class="inline-flex w-fit items-center justify-center rounded-lg bg-white px-8 py-3 font-[Geist_Mono] text-[12px] font-semibold uppercase leading-[1.12] tracking-[-0.01em] text-primary"
      >
        {ctaLabel}
      </a>
    </div>

    <!-- Right group: nav + locations -->
    <div class="flex flex-col gap-10 lg:flex-1 lg:flex-row lg:justify-between">

    <!-- Center: nav links -->
    <nav class="flex flex-col gap-7 lg:pt-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="font-[Geist] text-[16px] font-medium leading-[1.2] tracking-[-0.01em] text-white transition-opacity hover:opacity-60"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right: locations -->
    <div class="flex flex-col gap-11 lg:pt-2">
      {locations.map((loc) => (
        <div>
          <p class="font-[Geist] text-[16px] font-medium leading-[1.2] tracking-[-0.01em] text-white">
            {loc.city}, {loc.country}
          </p>
          {loc.phone && (
            <p class="mt-2 font-[Geist] text-[14px] font-normal leading-[1.2] tracking-[-0.01em] text-white">{loc.phone}</p>
          )}
          {loc.address && (
            <p class="mt-2 font-[Geist] text-[14px] font-normal leading-[1.2] tracking-[-0.01em] text-white whitespace-pre-line">
              {loc.address}
            </p>
          )}
        </div>
      ))}
    </div>

    </div> <!-- end right group -->
  </div>

  <!-- Endless Tools animation -->
  <div id="footer-iframe-outer" class="lg:mx-10" style="position:relative; overflow:hidden; margin-bottom:-200px;">
    <div id="footer-iframe-skeleton" style="position:absolute;inset:0;background:linear-gradient(90deg,#111 25%,#1a1a1a 50%,#111 75%);background-size:200% 100%;"></div>
    <iframe
      id="footer-iframe"
      src="https://app.endlesstools.io/embed/8be04683-240c-40ba-b873-845f8bbb646c"
      allowtransparency="true"
      frameborder="0"
      loading="lazy"
      allow="clipboard-write; encrypted-media; gyroscope; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      aria-hidden="true"
      style="display:block; width:100%; height:55vh; border:none; background:transparent; opacity:0; pointer-events:none;"
    />
  </div>
</footer>

<style is:global>
  @keyframes footer-shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  #footer-iframe-skeleton { animation: footer-shimmer 1.5s infinite; }
</style>

<script>
  const iframe   = document.getElementById('footer-iframe') as HTMLIFrameElement | null
  const skeleton = document.getElementById('footer-iframe-skeleton')
  const outer    = document.getElementById('footer-iframe-outer') as HTMLElement | null

  if (iframe) {
    iframe.addEventListener('load', () => {
      iframe.style.opacity = '1'
      iframe.style.pointerEvents = 'auto'
      if (skeleton) skeleton.style.display = 'none'
    })
  }

  function applyMargins() {
    if (!outer) return
    outer.style.marginLeft  = window.innerWidth >= 1024 ? '40px' : '0'
    outer.style.marginRight = window.innerWidth >= 1024 ? '40px' : '0'
  }
  applyMargins()
  window.addEventListener('resize', applyMargins)
</script>


