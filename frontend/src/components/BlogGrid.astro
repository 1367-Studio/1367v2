---
interface Author {
  name: string;
  avatarUrl?: string;
}

interface Category {
  name: string;
  slug: string;
}

interface PostCard {
  title: string;
  slug: string;
  excerpt?: string;
  ctaLabel?: string;
  publishedAt?: string;
  readTime?: number;
  coverImageUrl?: string;
  coverImageAlt?: string;
  authors?: Author[];
  categories?: Category[];
}

interface Props {
  posts: PostCard[];
}

const { posts = [] } = Astro.props;

// Placeholder fill for posts without a cover image yet, cycled by
// position so the grid reads as a set rather than one flat gray block.
const PLACEHOLDER_COLORS = ["#000000", "#4D4D4D", "#666666", "#B4B4B4"];

function formatDate(dateStr?: string) {
  if (!dateStr) return undefined;
  return new Date(dateStr).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<section class="bg-white px-6 py-16 text-black lg:px-12 lg:py-24">
  <div class="mx-auto max-w-[1216px]">
    {
      posts.length > 0 ? (
        <div class="grid grid-cols-1 gap-x-4 gap-y-12 md:grid-cols-2 lg:grid-cols-3 lg:gap-y-16">
          {posts.map((post, i) => (
            <a
              href={`/blog/${post.slug}`}
              class="group flex flex-col"
              data-categories={(post.categories ?? []).map((c) => c.slug).join(",")}
            >
              <div
                class="aspect-[4/3] w-full overflow-hidden rounded-[8px]"
                style={`background-color: ${PLACEHOLDER_COLORS[i % PLACEHOLDER_COLORS.length]};`}
              >
                {post.coverImageUrl && (
                  <img
                    src={post.coverImageUrl}
                    alt={post.coverImageAlt || post.title}
                    class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  />
                )}
              </div>
              <div class="mt-6 flex items-center justify-between gap-2">
                {post.categories && post.categories.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {post.categories.map((category) => (
                      <span class="rounded-full border border-[#e5e5e5] px-3 py-1 font-[Geist_Mono] text-[10px] font-normal uppercase leading-[120%] tracking-[-0.01em] text-[#666666]">
                        {category.name}
                      </span>
                    ))}
                  </div>
                )}
                {(post.readTime || post.publishedAt) && (
                  <span class="ml-auto shrink-0 font-[Geist_Mono] text-[12px] font-normal uppercase leading-[120%] tracking-[-0.01em] text-[#666666]">
                    {post.readTime && `${post.readTime} min read`}
                    {post.readTime && post.publishedAt && " · "}
                    {formatDate(post.publishedAt)}
                  </span>
                )}
              </div>
              <h2 class="mt-2 font-[Geist] text-base font-medium leading-[1.2] tracking-[-0.01em] text-black">
                {post.title}
              </h2>
              {post.excerpt && (
                <p class="mt-2 font-[Geist] text-sm leading-relaxed text-[#666666]">
                  {post.excerpt}
                </p>
              )}
              {post.authors && post.authors.length > 0 && (
                <div class="mt-4 flex items-center gap-2">
                  <div class="flex -space-x-2">
                    {post.authors.map((author) =>
                      author.avatarUrl ? (
                        <img
                          src={author.avatarUrl}
                          alt={author.name}
                          class="h-6 w-6 rounded-full border-2 border-white object-cover"
                        />
                      ) : (
                        <span class="flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-[#f3f3f4] text-[10px] text-black">
                          {author.name?.[0]}
                        </span>
                      ),
                    )}
                  </div>
                  <span class="font-[Geist] text-xs text-[#666666]">
                    {post.authors.map((a) => a.name).join(", ")}
                  </span>
                </div>
              )}
              <span class="mt-auto inline-flex w-fit items-center gap-1 self-end pt-4 font-[Geist_Mono] text-[12px] font-normal uppercase leading-[120%] tracking-[-0.01em] text-black transition-opacity group-hover:opacity-60">
                {post.ctaLabel || "Read more"}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="font-[Geist] text-sm text-[#666666]">
          More posts coming soon.
        </p>
      )
    }
  </div>
</section>
