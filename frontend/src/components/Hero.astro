---
interface Props {
  title: string
  subtitle: string
  description: string
  ctaLabel: string
  ctaHref: string
  videoUrl: string
}

const { title, subtitle, description, ctaLabel, ctaHref, videoUrl } = Astro.props
---

<section class="relative h-[90vh] w-full overflow-hidden">
  {/* Vídeo de fundo */}
  <video
    class="absolute inset-0 h-full w-full object-cover"
    src={videoUrl}
    autoplay
    muted
    loop
    playsinline
  />

  {/* Overlay escuro */}
  <div class="absolute inset-0 bg-black/50" />

  {/* Conteúdo */}
  <div class="absolute bottom-12 left-8 right-8 flex items-end justify-between">
    <div>
      <h1 class="text-2xl text-white md:text-4xl">{title}</h1>
      <p class="mt-2 text-2xl text-muted md:text-4xl">{subtitle}</p>
    </div>
      <p class="text-xs text-white uppercase max-w-[160px]">{description}</p>
    <a
      href={ctaHref}
      class="rounded-lg bg-primary px-6 py-3 text-xs font-semibold text-white hover:bg-white/90"
    >
      {ctaLabel}
    </a>
  </div>
</section>
