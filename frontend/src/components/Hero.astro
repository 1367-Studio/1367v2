---
interface Props {
  title: string
  subtitle?: string
  description: string
  ctaLabel: string
  ctaHref: string
  videoUrl?: string
}

const { title, subtitle, description, ctaLabel, ctaHref, videoUrl } = Astro.props

const SDK_URL = "https://cdn.jsdelivr.net/gh/hiunicornstudio/unicornstudio.js@v2.2.1/dist/unicornStudio.umd.js"
---

<section class="relative h-screen w-full overflow-hidden bg-[#0f0f0f]">
  <div
    id="unicorn-scene"
    class="absolute inset-0 w-full h-full overflow-hidden"
    style="display:flex;align-items:flex-start;"
  />

  {/* Gradient at bottom for text readability */}
  <div class="absolute inset-x-0 bottom-0 h-80 bg-gradient-to-t from-[#0f0f0f]/80 to-transparent lg:h-64" />

  {/* Bottom content row */}
  <div class="absolute bottom-6 left-6 right-6 flex flex-col gap-6 lg:bottom-10 lg:left-10 lg:right-10 lg:flex-row lg:items-end lg:justify-between lg:gap-8">
    <h1 class="font-[Geist] text-[32px] font-normal leading-[1.04]">
      <span class="block text-white lg:whitespace-nowrap">{title}</span>
      {subtitle && <span class="block text-white/40 lg:whitespace-nowrap">{subtitle}</span>}
    </h1>

    <div class="flex items-end gap-6">
      <p class="max-w-[216px] font-[Geist_Mono] text-[12px] font-normal uppercase leading-[1.2] tracking-[-0.01em] text-white/80">
        {description}
      </p>

      <a
        href={ctaHref}
        class="shrink-0 rounded-lg bg-primary px-8 py-3 font-[Geist_Mono] text-[12px] font-semibold uppercase leading-[1.12] tracking-[-0.01em] text-white transition-opacity hover:opacity-90"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</section>

<script define:vars={{ SDK_URL }}>
  (function () {
    function initScene() {
      if (!window.UnicornStudio) return
      window.UnicornStudio.addScene({
        elementId: "unicorn-scene",
        filePath: "/scene.json",
        scale: 1,
        dpi: 1.5,
        lazyLoad: false,
      })
    }

    var script = document.createElement("script")
    script.src = SDK_URL
    script.onload = initScene
    document.head.appendChild(script)
  })()
</script>
