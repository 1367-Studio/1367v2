---
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import BaseHead from "../components/BaseHead.astro"
import LazyAskAgent from "../components/LazyAskAgent"
import { getAgentConfig } from "@/lib/agent-knowledge"
import { markdownPathFor } from "@/lib/markdown"
import { client } from "@/lib/sanity"
import imageUrlBuilder from '@sanity/image-url'
import "@/styles/global.css";

const builder = imageUrlBuilder(client)
function urlFor(source: any) {
  return builder.image(source).url()
}

const footerData = await client.fetch(`
  *[_type == "footer"][0]{
    heading, ctaLabel, ctaHref,
    navLinks[]{ label, href },
    heading_fr, ctaLabel_fr, navLinks_fr[]{ label, href },
    locations[]{ city, country, phone, address },
    logo
  }
`)

const agentConfig = await getAgentConfig()
const markdownPath = markdownPathFor(Astro.url.pathname)

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  headerTheme?: 'light' | 'dark';
  hideFooter?: boolean;
  lang?: "en" | "fr";
  alternates?: { hreflang: string; href: string }[];
  jsonLd?: Record<string, unknown>[];
}

const { title, description, image, type, noindex, headerTheme, hideFooter, lang = "en", alternates, jsonLd } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} type={type} noindex={noindex} lang={lang} alternates={alternates} jsonLd={jsonLd} />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    {/* Fonts are self-hosted (see global.css); preload the two used above the fold. */}
    <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Header theme={headerTheme}/>
    <!-- Header is persistent across Barba transitions. Footer lives INSIDE the
         swapped container (not outside like Header) because it's conditional
         per page (hideFooter) — if it stayed persistent, that prop would only
         ever be evaluated on the first hard load and never again after an SPA
         navigation, leaving a stale Footer state on later pages. -->
    <div data-barba="wrapper">
      <main data-barba="container" data-barba-namespace={Astro.url.pathname}>
        <slot />
        {!hideFooter && (
          <Footer
            lang={lang}
            heading={(lang === "fr" ? footerData?.heading_fr : footerData?.heading) ?? undefined}
            ctaLabel={(lang === "fr" ? footerData?.ctaLabel_fr : footerData?.ctaLabel) ?? undefined}
            ctaHref={footerData?.ctaHref ?? undefined}
            navLinks={(lang === "fr" ? footerData?.navLinks_fr : footerData?.navLinks) ?? undefined}
            locations={footerData?.locations ?? undefined}
            logoSrc={footerData?.logo ? builder.image(footerData.logo).height(64).fit('max').auto('format').url() : undefined}
          />
        )}
      </main>
    </div>
    <LazyAskAgent client:only="react" {...agentConfig} />
    <script>
      import { initBarba } from "@/lib/barba";

      initBarba();
    </script>
  </body>
</html>
