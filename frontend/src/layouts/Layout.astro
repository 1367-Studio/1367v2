---
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import BaseHead from "../components/BaseHead.astro"
import AskAgent from "../components/AskAgent"
import { getAgentConfig } from "@/lib/agent-knowledge"
import { client } from "@/lib/sanity"
import imageUrlBuilder from '@sanity/image-url'
import "@/styles/global.css";

const builder = imageUrlBuilder(client)
function urlFor(source: any) {
  return builder.image(source).url()
}

const footerData = await client.fetch(`
  *[_type == "footer"][0]{
    heading, ctaLabel, ctaHref,
    navLinks[]{ label, href },
    locations[]{ city, country, phone, address },
    logo
  }
`)

const agentConfig = await getAgentConfig()

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  headerTheme?: 'light' | 'dark';
  hideFooter?: boolean;
}

const { title, description, image, type, noindex, headerTheme, hideFooter } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} noindex={noindex} />
    {/* Google Fonts */}
    <link rel="preconnect" href="https://app.endlesstools.io">
    <link rel="dns-prefetch" href="https://app.endlesstools.io">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Instrument+Sans:wght@400;600&family=Inter:wght@400;600&family=Playfair+Display:wght@400&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header theme={headerTheme}/>
    <!-- Header is persistent across Barba transitions. Footer lives INSIDE the
         swapped container (not outside like Header) because it's conditional
         per page (hideFooter) — if it stayed persistent, that prop would only
         ever be evaluated on the first hard load and never again after an SPA
         navigation, leaving a stale Footer state on later pages. -->
    <div data-barba="wrapper">
      <main data-barba="container" data-barba-namespace={Astro.url.pathname}>
        <slot />
        {!hideFooter && (
          <Footer
            heading={footerData?.heading ?? undefined}
            ctaLabel={footerData?.ctaLabel ?? undefined}
            ctaHref={footerData?.ctaHref ?? undefined}
            navLinks={footerData?.navLinks ?? undefined}
            locations={footerData?.locations ?? undefined}
            logoSrc={footerData?.logo ? builder.image(footerData.logo).height(64).fit('max').auto('format').url() : undefined}
          />
        )}
      </main>
    </div>
    <AskAgent client:only="react" {...agentConfig} />
    <script>
      import { initBarba } from "@/lib/barba";

      initBarba();
    </script>
  </body>
</html>
